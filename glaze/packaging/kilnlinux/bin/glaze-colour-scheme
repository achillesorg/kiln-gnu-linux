#!/usr/bin/env bash
# glaze-colour-scheme dark|light|toggle|status
# Applies the light/dark scheme to GTK 3/4 (incl. libadwaita), portal-aware apps (Firefox, Flatpak) and Qt 5/6
# (via the GTK platform theme). Called by Glaze Settings / glaze-shell when the scheme changes, and at session start.
# Running GTK4/libadwaita and portal-aware apps switch live; GTK3 and Qt apps pick it up the next time they start.
set -euo pipefail
cmd="${1:-status}"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"

current() { gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'" || echo default; }

set_ini() { # file key value
  mkdir -p "$(dirname "$1")"
  [ -f "$1" ] || printf '[Settings]\n' > "$1"
  grep -q '^\[Settings\]' "$1" || sed -i '1i [Settings]' "$1"
  if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else sed -i "/^\[Settings\]/a $2=$3" "$1"; fi
}

apply() {
  local scheme="$1" prefer theme
  if [ "$scheme" = dark ]; then prefer=1; theme=Adwaita-dark; gs=prefer-dark; else prefer=0; theme=Adwaita; gs=default; fi
  gsettings set org.gnome.desktop.interface color-scheme "$gs" || true
  gsettings set org.gnome.desktop.interface gtk-theme "$theme" || true
  for v in gtk-3.0 gtk-4.0; do
    set_ini "$cfg/$v/settings.ini" gtk-application-prefer-dark-theme "$prefer"
    set_ini "$cfg/$v/settings.ini" gtk-theme-name "$theme"
  done
  # GTK4 (libadwaita) honours color-scheme only; keep GTK4 theme name plain.
  set_ini "$cfg/gtk-4.0/settings.ini" gtk-theme-name Adwaita
  mkdir -p "$cfg/glaze"; echo "$scheme" > "$cfg/glaze/colour-scheme"
  # Compatibility: apps built before the FeDe -> Glaze rename (kiln-terminal,
  # kiln-files) still read ~/.config/fede/colour-scheme.
  [ -d "$cfg/fede" ] && echo "$scheme" > "$cfg/fede/colour-scheme"
  command -v kiln-terminal-scheme >/dev/null && kiln-terminal-scheme "$scheme" || true
  # Qt: the style override is read from /etc/profile.d/kiln-theme.sh at login (new Qt apps from the next login).
  # Sway window frames: recolour live if sway is running. Colours = the
  # default Glaze Clay tokens (glaze-design), same mapping as glaze-shell, which
  # repaints them from the live tokens (custom accent) and passes
  # GLAZE_SWAY_FRAMES=skip when it calls this script.
  if [ -z "${SWAYSOCK:-}" ]; then SWAYSOCK="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/sway-ipc.*.sock 2>/dev/null | head -1 || true)"; export SWAYSOCK; fi
  if [ "${GLAZE_SWAY_FRAMES:-}" != skip ] && [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null; then
    if [ "$scheme" = dark ]; then
      swaymsg "client.focused #D97757 #33302C #F3EFE6 #D97757 #584035; client.focused_inactive #4A4640 #2B2926 #B3AC9F #2B2926 #2B2926; client.unfocused #4A4640 #2B2926 #B3AC9F #2B2926 #2B2926; client.urgent #D97757 #EE8A7C #F3EFE6 #EE8A7C #EE8A7C; client.background #2B2926" >/dev/null || true
    else
      swaymsg "client.focused #D97757 #FCFBF7 #2B2926 #D97757 #F4DED4; client.focused_inactive #CFC6B4 #F5F2EA #6B665C #F5F2EA #F5F2EA; client.unfocused #CFC6B4 #F5F2EA #6B665C #F5F2EA #F5F2EA; client.urgent #D97757 #B03A2E #2B2926 #B03A2E #B03A2E; client.background #F5F2EA" >/dev/null || true
    fi
  fi
}

case "$cmd" in
  dark|light) apply "$cmd" ;;
  toggle) if [ "$(current)" = prefer-dark ]; then apply light; else apply dark; fi ;;
  status) echo "$(current)" ;;
  *) echo "usage: glaze-colour-scheme dark|light|toggle|status" >&2; exit 2 ;;
esac
