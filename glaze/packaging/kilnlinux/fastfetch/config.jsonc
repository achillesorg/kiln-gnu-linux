{
  // Kiln GNU/Linux system-wide fastfetch config (installed to /etc/xdg/fastfetch/config.jsonc)
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/kiln/logo.txt",
    "color": { "1": "38;2;217;119;87", "2": "38;2;250;249;245" },
    "padding": { "top": 1, "right": 4 }
  },
  "display": { "separator": "  ", "color": { "keys": "38;2;217;119;87", "title": "38;2;217;119;87" } },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "{name} {version-id}" },
    "host",
    { "type": "command", "key": "Kernel", "text": "echo \"Linux $(uname -r | sed 's/+deb[0-9]*//')\"" },
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
