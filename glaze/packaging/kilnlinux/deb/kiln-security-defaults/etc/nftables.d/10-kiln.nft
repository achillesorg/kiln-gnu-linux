# Kiln default firewall: deny inbound, allow outbound. Profile switch: kiln-fw home|public (see usr/sbin/kiln-fw).
# Profile sets are filled from /etc/nftables.d/profile-home.nft or profile-public.nft (generated by kiln-fw).
table inet kiln {
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    # ICMPv6 NDP/errors, ping rate-limited
    meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    icmp type echo-request limit rate 5/second accept
    icmpv6 type echo-request limit rate 5/second accept
    # DHCP client replies
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    jump profile
  }
  chain forward { type filter hook forward priority filter; policy drop; }
  chain output  { type filter hook output priority filter; policy accept; }
  chain profile { }
}
include "/etc/nftables.d/profile-active.nft"
