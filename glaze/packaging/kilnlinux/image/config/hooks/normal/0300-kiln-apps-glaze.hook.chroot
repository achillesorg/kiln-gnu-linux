#!/bin/sh
# Finish the staged Kiln apps and Glaze session (files come from config/includes.chroot/usr/local, see ../../stage.sh).
set -e
ldconfig
[ -d /usr/local/share/glib-2.0/schemas ] && glib-compile-schemas /usr/local/share/glib-2.0/schemas
[ -d /usr/local/share/icons/Kiln ] && gtk-update-icon-cache -qf /usr/local/share/icons/Kiln || true
update-desktop-database /usr/local/share/applications 2>/dev/null || true
# Debian's archive plugin works with the Kiln Files fork (same Thunar ABI)
mkdir -p /usr/local/lib/thunarx-3
for p in /usr/lib/*/thunarx-3/thunar-archive-plugin.so; do [ -e "$p" ] && ln -sf "$p" /usr/local/lib/thunarx-3/ || true; done
# Plymouth boot splash
if [ -d /usr/share/plymouth/themes/kiln ]; then
  plymouth-set-default-theme kiln || true
  update-initramfs -u || true
fi
# Live user's home: first-boot defaults come from /etc/skel (bash_profile, sway.conf)
