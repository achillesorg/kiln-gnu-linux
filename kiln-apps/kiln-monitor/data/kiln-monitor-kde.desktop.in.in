[Desktop Entry]
Name=GNOME Kiln Monitor
Comment=View current processes and monitor system state
TryExec=kiln-monitor
Exec=kiln-monitor
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=@APP_ID@
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=kiln-monitor
Categories=GNOME;GTK;System;Monitor;
OnlyShowIn=KDE;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=Monitor;System;Process;CPU;Memory;Network;History;Usage;
