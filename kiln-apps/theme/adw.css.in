/* Kiln GNU/Linux flat cut-paper theme for libadwaita apps. Generated by tools/gen-css.py from adw.css.in.
   Overrides libadwaita's named colours; widgets are not rewritten. */
@define-color accent_color @accent_text;
@define-color accent_bg_color @accent;
@define-color accent_fg_color #2B1A12;
@define-color destructive_color @danger;
@define-color destructive_bg_color @danger;
@define-color destructive_fg_color #FFFFFF;
@define-color window_bg_color @bg;
@define-color window_fg_color @ink;
@define-color view_bg_color @base;
@define-color view_fg_color @ink;
@define-color headerbar_bg_color @raised;
@define-color headerbar_fg_color @ink;
@define-color headerbar_border_color @line;
@define-color headerbar_backdrop_color @raised;
@define-color headerbar_shade_color @line;
@define-color headerbar_darker_shade_color @line;
@define-color sidebar_bg_color @panel;
@define-color sidebar_fg_color @ink;
@define-color sidebar_backdrop_color @panel;
@define-color sidebar_border_color @line;
@define-color sidebar_shade_color @line;
@define-color secondary_sidebar_bg_color @panel;
@define-color secondary_sidebar_fg_color @ink;
@define-color secondary_sidebar_backdrop_color @panel;
@define-color secondary_sidebar_border_color @line;
@define-color secondary_sidebar_shade_color @line;
@define-color card_bg_color @raised;
@define-color card_fg_color @ink;
@define-color card_shade_color alpha(@ink, 0.07);
@define-color dialog_bg_color @bg;
@define-color dialog_fg_color @ink;
@define-color popover_bg_color @raised;
@define-color popover_fg_color @ink;
@define-color popover_shade_color @line;
@define-color shade_color alpha(@ink, 0.07);
@define-color scrollbar_outline_color transparent;
@define-color thumbnail_bg_color @sunken;
@define-color thumbnail_fg_color @ink;

* { font-family: "Inter", "Noto Sans", sans-serif; }
window, window.background { background-color: @bg; color: @ink; }
window.csd, window.csd:backdrop, window.solid-csd { box-shadow: none; border: 1px solid @line; border-radius: 6px; }
window.maximized, window.fullscreen, window.tiled { border-radius: 0; border: none; }
*:focus-visible { outline-color: alpha(@accent, 0.6); outline-width: 1px; outline-offset: -2px; }
headerbar { box-shadow: none; background-image: none; border-bottom: 1px solid @line; min-height: 40px; }
headerbar button, .toolbar button { border-radius: 5px; }
button { box-shadow: none; background-image: none; border-radius: 5px; }
button.flat { background-color: transparent; }
button:not(.flat):not(.suggested-action):not(.destructive-action):not(.circular):not(.image-button.flat) { background-color: @raised; border: 1px solid @line; }
button:hover:not(:disabled), button.flat:hover { background-color: @hover; }
button:checked, button.flat:checked { background-color: @sel_bg; color: @sel_fg; }
button.suggested-action { background-color: @accent; color: #2B1A12; }
button.suggested-action:hover { background-color: @accent_hi; }
entry, spinbutton, .card, .boxed-list, list.boxed-list, searchbar > revealer > box { border-radius: 6px; box-shadow: none; }
entry, spinbutton { background-color: @base; border: 1px solid @line; }
entry:focus-within, spinbutton:focus-within { border-color: @accent; outline: none; }
.card, .boxed-list, list.boxed-list { background-color: @raised; border: 1px solid @line; }
popover > contents, popover.background > contents { border-radius: 6px; box-shadow: 0 2px 0 alpha(@ink, 0.10); border: 1px solid @line; }
menu, .menu { border-radius: 6px; }
modelbutton:hover, row:hover { background-color: @hover; }
row:selected, listview > row:selected, .navigation-sidebar > row:selected, sidebar row:selected { background-color: @sel_bg; color: @sel_fg; }
.navigation-sidebar, .sidebar-pane, .sidebar { background-color: @panel; }
separator, .sidebar separator, headerbar separator { background-color: @line; }
tooltip, tooltip.background { box-shadow: none; border: 1px solid @line; border-radius: 5px; }
switch { box-shadow: none; background-image: none; border: 1px solid @line; }
switch:checked { background-color: @accent; border-color: @accent; }
switch slider { box-shadow: none; border: 1px solid @line; background-color: @raised; }
scale trough { background-color: @sunken; border: 1px solid @line; }
scale highlight { background-color: @accent; }
progressbar progress { background-color: @accent; }
toast { border-radius: 6px; box-shadow: none; border: 1px solid @line; }
tabbar tab:selected, tabbar tab:checked { box-shadow: inset 0 -2px @accent; }
.dim-label, .caption, .subtitle { color: @muted; }
.title-1, .title-2, .title-3, .title-4, .heading { font-family: "Source Serif 4", "Noto Serif", serif; }
.kiln-pill { background-color: @sel_bg; color: @sel_fg; border-radius: 8px; padding: 0 7px; }
.kiln-plain, .kiln-plain row { background: transparent; }
