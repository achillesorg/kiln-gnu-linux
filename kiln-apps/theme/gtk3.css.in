/* Kiln GNU/Linux flat cut-paper theme for GTK3 apps. Generated by tools/gen-css.py from gtk3.css.in. */
@define-color theme_bg_color @bg;
@define-color theme_base_color @base;
@define-color theme_fg_color @ink;
@define-color theme_text_color @ink;
@define-color theme_selected_bg_color @sel_bg;
@define-color theme_selected_fg_color @sel_fg;
@define-color theme_unfocused_bg_color @bg;
@define-color theme_unfocused_base_color @base;
@define-color theme_unfocused_fg_color @ink;
@define-color theme_unfocused_text_color @ink;
@define-color theme_unfocused_selected_bg_color @sel_bg;
@define-color theme_unfocused_selected_fg_color @sel_fg;
@define-color borders @line;
@define-color unfocused_borders @line;
@define-color insensitive_bg_color @bg;
@define-color insensitive_fg_color @muted;
@define-color link_color @accent;
@define-color kiln_accent @accent;

* { font-family: "Inter", "Noto Sans", sans-serif; -gtk-icon-style: regular; outline-color: alpha(@accent, 0.55); outline-style: solid; outline-width: 1px; outline-offset: -2px; }
window, window.background, .background { background-color: @bg; background-image: none; color: @ink; }
decoration, window decoration { box-shadow: none; border-radius: 0; }

/* chrome rows */
menubar { background-color: @raised; background-image: none; border: none; border-bottom: 1px solid @line; box-shadow: none; padding: 0 4px; color: @ink; }
menubar > menuitem { padding: 5px 10px; border-radius: 5px; margin: 2px 0; color: @ink; }
menubar > menuitem:hover, menubar > menuitem:checked { background-color: @hover; color: @ink; }
toolbar, .toolbar, .inline-toolbar, .primary-toolbar { background-color: @raised; background-image: none; border: none; border-bottom: 1px solid @line; box-shadow: none; padding: 4px 6px; }
menu, .menu, .popup, popover, popover.background { background-color: @raised; background-image: none; border: 1px solid @line; border-radius: 6px; box-shadow: 0 2px 0 alpha(@ink, 0.10); color: @ink; padding: 3px; }
menu menuitem, .menu .menuitem, modelbutton { padding: 5px 10px; border-radius: 4px; color: @ink; min-height: 22px; }
menu menuitem:hover, .menu .menuitem:hover, modelbutton:hover, menuitem:hover { background-color: @sel_bg; color: @sel_fg; }
menu separator, .menu separator, separator { background-color: @line; min-height: 1px; min-width: 1px; }
menuitem arrow { min-width: 12px; }

/* buttons */
button, button.flat { background-image: none; background-color: @raised; color: @ink; border: 1px solid @line; border-radius: 5px; box-shadow: none; text-shadow: none; padding: 4px 10px; min-height: 22px; }
button.flat, toolbar button, .toolbar button, headerbar button { background-color: transparent; border-color: transparent; }
button:hover, button.flat:hover, toolbar button:hover { background-color: @hover; border-color: @line; box-shadow: none; background-image: none; }
button:active, button:checked, toolbar button:checked, toolbar button:active { background-color: @sel_bg; background-image: none; border-color: @accent; color: @sel_fg; box-shadow: none; }
button:disabled, button:disabled label { color: @muted; background-color: transparent; border-color: @line; }
button.suggested-action, button.default { background-color: @accent; color: #2B1A12; border-color: @accent; background-image: none; }
button.suggested-action:hover { background-color: @accent_hi; }
button.destructive-action { background-color: @danger; color: #FFFFFF; border-color: @danger; background-image: none; }
button:focus { outline-offset: -3px; }
.linked > button { border-radius: 0; }
.linked > button:first-child { border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
.linked > button:last-child { border-top-right-radius: 5px; border-bottom-right-radius: 5px; }
checkbutton, radiobutton { color: @ink; }
check, radio { background-image: none; background-color: @base; border: 1px solid @muted; box-shadow: none; color: transparent; -gtk-icon-source: none; min-width: 14px; min-height: 14px; }
check { border-radius: 4px; } radio { border-radius: 8px; }
check:checked, radio:checked, check:indeterminate { background-color: @accent; border-color: @accent; color: #2B1A12; }
check:checked { -gtk-icon-source: -gtk-icontheme("object-select-symbolic"); }
switch { background-image: none; background-color: @sunken; border: 1px solid @line; border-radius: 12px; box-shadow: none; color: @ink; }
switch:checked { background-color: @accent; border-color: @accent; }
switch slider { background-image: none; background-color: @raised; border: 1px solid @line; border-radius: 12px; box-shadow: none; }

/* entries */
entry, spinbutton, .entry, combobox entry { background-color: @base; background-image: none; color: @ink; border: 1px solid @line; border-radius: 5px; box-shadow: none; padding: 4px 8px; min-height: 22px; caret-color: @ink; }
entry:focus, spinbutton:focus { border-color: @accent; box-shadow: none; outline-style: none; }
entry selection, label selection, textview selection, *:selected { background-color: @sel_bg; color: @sel_fg; }
entry image { color: @muted; }
spinbutton button { border-radius: 0; border-width: 0 0 0 1px; }
combobox button, button.combo { padding: 3px 8px; }
scale trough { background-color: @sunken; background-image: none; border: 1px solid @line; border-radius: 4px; min-height: 4px; box-shadow: none; }
scale highlight { background-color: @accent; background-image: none; border: none; border-radius: 4px; }
scale slider { background-image: none; background-color: @raised; border: 1px solid @muted; border-radius: 10px; box-shadow: none; }
progressbar trough { background-color: @sunken; border: 1px solid @line; border-radius: 4px; box-shadow: none; min-height: 6px; background-image: none; }
progressbar progress { background-color: @accent; background-image: none; border: none; border-radius: 4px; }

/* lists, views, panes */
.view, iconview, treeview.view, textview, textview text, list, listview { background-color: @base; background-image: none; color: @ink; }
treeview.view { border-color: @line; }
treeview.view:selected, iconview:selected, .view:selected, row:selected, list row:selected { background-color: @sel_bg; color: @sel_fg; border-radius: 4px; }
treeview.view:hover, row:hover { background-color: @hover; }
treeview.view header button, header button { background-image: none; background-color: @raised; border: none; border-bottom: 1px solid @line; border-right: 1px solid @line; border-radius: 0; color: @muted; font-weight: 600; box-shadow: none; padding: 4px 8px; }
iconview { padding: 4px; }
iconview:selected { background-color: @sel_bg; border-radius: 6px; }
scrolledwindow, scrolledwindow viewport { border: none; background-color: @base; }
scrolledwindow.frame, frame > border, .frame { border: 1px solid @line; border-radius: 5px; box-shadow: none; }
scrollbar { background-color: transparent; border: none; }
scrollbar slider { background-color: alpha(@muted, 0.55); border-radius: 6px; border: 2px solid transparent; min-width: 6px; min-height: 28px; background-clip: padding-box; }
scrollbar slider:hover { background-color: @muted; }
scrollbar trough { background-color: transparent; border: none; }
paned > separator { background-color: @line; background-image: none; min-width: 1px; min-height: 1px; }
paned > separator.wide { min-width: 5px; min-height: 5px; background-color: transparent; }
notebook { background-color: @bg; }
notebook > header { background-color: @bg; border-color: @line; box-shadow: none; }
notebook > header tab { background-color: transparent; border: none; border-bottom: 2px solid transparent; color: @muted; padding: 4px 12px; box-shadow: none; }
notebook > header tab:checked { color: @ink; border-bottom-color: @accent; background-color: @raised; }
statusbar frame, statusbar frame > border, statusbar > box > frame { border: none; box-shadow: none; }
statusbar, .statusbar { background-color: @raised; border-top: 1px solid @line; color: @muted; padding: 2px 6px; box-shadow: none; }
tooltip, tooltip.background { background-color: @ink_bg; color: @ink_fg; border: 1px solid @line; border-radius: 5px; box-shadow: none; }
tooltip * { color: @ink_fg; }
dialog, messagedialog, .dialog-action-area { background-color: @bg; }
infobar, .infobar { background-color: @sel_bg; color: @sel_fg; border: 1px solid @accent; border-radius: 5px; }
infobar button { background-color: @raised; }
headerbar, .titlebar { background-image: none; background-color: @raised; border: none; border-bottom: 1px solid @line; box-shadow: none; color: @ink; border-radius: 0; }

/* Kiln Files specifics */
.sidebar, .sidebar .view, .sidebar treeview.view, .shortcuts-pane, .shortcuts-pane treeview.view { background-color: @panel; color: @ink; }
.sidebar treeview.view:selected, .shortcuts-pane treeview.view:selected, .sidebar row:selected, .sidebar treeview.view:selected:focus { background-color: @sel_bg; color: @sel_fg; border-radius: 5px; }
.sidebar treeview.view:hover { background-color: @hover; }
.shortcuts-pane, .sidebar { border-right: 1px solid @line; }
.sidebar treeview.view header, .shortcuts-pane header { background-color: @panel; }
.path-bar button, .path-bar button.flat { padding: 3px 8px; border-radius: 5px; background-color: transparent; border-color: transparent; }
.path-bar button:hover { background-color: @hover; border-color: @line; }
.path-bar button:checked, .path-bar button:active { background-color: @sel_bg; color: @sel_fg; border-color: @accent; }
.location-button, .path-bar .toggle { box-shadow: none; }
.thunar-main-window .location-bar { background-color: @raised; }
