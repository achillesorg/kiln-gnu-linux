[Icon Theme]
Name=Kiln
Comment=Kiln GNU/Linux flat paper icons (folders and places); falls back to Adwaita
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/mimetypes,scalable/devices,scalable/apps

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/devices]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
