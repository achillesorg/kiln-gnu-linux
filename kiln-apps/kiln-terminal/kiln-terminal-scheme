#!/bin/sh
# kiln-terminal-scheme dark|light : switch every running Kiln Terminal live (SIGUSR1 = dark, SIGUSR2 = light).
# Call it from glaze-colour-scheme after the scheme file is written.
case "$1" in
  dark) pkill -USR1 -x kiln-terminal ;;
  light) pkill -USR2 -x kiln-terminal ;;
  *) echo "usage: kiln-terminal-scheme dark|light" >&2; exit 2 ;;
esac
exit 0
