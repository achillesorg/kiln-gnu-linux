[Desktop Entry]
Type=Application
Version=1.0
Name=Kiln Terminal
GenericName=Terminal
Comment=The Kiln GNU/Linux terminal emulator
Exec=kiln-terminal
Icon=org.kiln.Terminal
Terminal=false
StartupNotify=false
StartupWMClass=org.kiln.Terminal
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;console;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=kiln-terminal
